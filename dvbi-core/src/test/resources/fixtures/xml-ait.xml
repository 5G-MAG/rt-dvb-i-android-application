<mhp:ServiceDiscovery xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mhp="urn:dvb:mhp:2009">
  <mhp:ApplicationDiscovery DomainName="example.com">
    <mhp:ApplicationList>
      <mhp:Application>
        <mhp:appName Language="eng">HbbTV player</mhp:appName>
        <mhp:applicationIdentifier><mhp:orgId>1</mhp:orgId><mhp:appId>1</mhp:appId></mhp:applicationIdentifier>
        <mhp:applicationDescriptor>
          <mhp:type><mhp:OtherApp>application/vnd.hbbtv.xhtml+xml</mhp:OtherApp></mhp:type>
          <mhp:controlCode>AUTOSTART</mhp:controlCode>
          <mhp:visibility>VISIBLE_ALL</mhp:visibility>
          <mhp:serviceBound>false</mhp:serviceBound>
          <mhp:priority>9</mhp:priority>
          <mhp:version>01</mhp:version>
        </mhp:applicationDescriptor>
        <mhp:applicationTransport xsi:type="mhp:HTTPTransportType"><mhp:URLBase>http://192.168.1.202:4100/</mhp:URLBase></mhp:applicationTransport>
        <mhp:applicationLocation>hbbtv.html</mhp:applicationLocation>
      </mhp:Application>
      <mhp:Application>
        <mhp:appName Language="eng">Low</mhp:appName>
        <mhp:applicationDescriptor>
          <mhp:type><mhp:OtherApp>text/html</mhp:OtherApp></mhp:type>
          <mhp:priority>1</mhp:priority>
        </mhp:applicationDescriptor>
        <mhp:applicationTransport xsi:type="mhp:HTTPTransportType"><mhp:URLBase>http://192.168.1.202:4100/</mhp:URLBase></mhp:applicationTransport>
        <mhp:applicationLocation>low.html</mhp:applicationLocation>
      </mhp:Application>
      <mhp:Application>
        <mhp:appName Language="eng">Player</mhp:appName>
        <mhp:applicationDescriptor>
          <mhp:type><mhp:OtherApp>text/html</mhp:OtherApp></mhp:type>
          <mhp:priority>3</mhp:priority>
        </mhp:applicationDescriptor>
        <mhp:applicationTransport xsi:type="mhp:HTTPTransportType"><mhp:URLBase><![CDATA[http://192.168.1.202:4100/]]></mhp:URLBase></mhp:applicationTransport>
        <mhp:applicationLocation>player.html?pid=5</mhp:applicationLocation>
      </mhp:Application>
      <mhp:Application>
        <mhp:appName Language="eng">Not provided</mhp:appName>
        <mhp:applicationDescriptor>
          <mhp:type><mhp:OtherApp>application/vnd.dvbi.non</mhp:OtherApp></mhp:type>
          <mhp:priority>5</mhp:priority>
        </mhp:applicationDescriptor>
        <mhp:applicationLocation>none</mhp:applicationLocation>
      </mhp:Application>
    </mhp:ApplicationList>
  </mhp:ApplicationDiscovery>
</mhp:ServiceDiscovery>
