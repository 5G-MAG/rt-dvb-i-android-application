<!-- The background of the 5G-MAG repository banners (repo-starter generate_banner.py, after the
     website's .topic-banner): #003580 to #00a0d2, under black from 62 % to 18 %, radius 14. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF003580" android:endColor="#FF00A0D2" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#9E000000" android:centerColor="#9E000000"
                android:centerX="0.45" android:endColor="#2E000000" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
