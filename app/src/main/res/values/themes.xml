<resources>
    <!-- The dark streaming theme of 5G-MAGflix (rt-5gms-application fivegmag_5GMSdAwareApplication
         res/values/themes.xml) on a DayNight parent, which App keeps in night mode so that inputs,
         dialogs and menus get their dark styles too. The font is Ubuntu, not 5G-MAGflix's. -->
    <style name="Theme.DVBIClient" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/fivegmag_blue</item>
        <item name="colorPrimaryVariant">@color/fivegmag_blue2</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/fivegmag_blue</item>
        <item name="colorSecondaryVariant">@color/fivegmag_blue2</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="colorSurface">@color/surface_dark_elevated</item>
        <item name="colorOnSurface">@color/on_surface_primary</item>
        <item name="android:statusBarColor">@color/status_bar_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="android:fontFamily">@font/ubuntu</item>
        <item name="fontFamily">@font/ubuntu</item>
        <item name="android:textColorPrimary">@color/on_surface_primary</item>
        <item name="android:textColorSecondary">@color/on_surface_secondary</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.DVBIClient.Dialog</item>
        <!-- The Material text appearances name sans-serif; these name Ubuntu. -->
        <item name="textAppearanceHeadline6">@style/TextAppearance.DVBIClient.Headline6</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.DVBIClient.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.DVBIClient.Subtitle2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.DVBIClient.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.DVBIClient.Body2</item>
        <item name="textAppearanceButton">@style/TextAppearance.DVBIClient.Button</item>
        <item name="textAppearanceCaption">@style/TextAppearance.DVBIClient.Caption</item>
        <item name="textAppearanceOverline">@style/TextAppearance.DVBIClient.Overline</item>
    </style>

    <!-- Dialogs in Ubuntu too. -->
    <style name="ThemeOverlay.DVBIClient.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:fontFamily">@font/ubuntu</item>
        <item name="fontFamily">@font/ubuntu</item>
        <item name="colorPrimary">@color/fivegmag_blue</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.DVBIClient.Headline6</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.DVBIClient.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.DVBIClient.Subtitle2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.DVBIClient.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.DVBIClient.Body2</item>
        <item name="textAppearanceButton">@style/TextAppearance.DVBIClient.Button</item>
        <item name="textAppearanceCaption">@style/TextAppearance.DVBIClient.Caption</item>
        <item name="textAppearanceOverline">@style/TextAppearance.DVBIClient.Overline</item>
    </style>

    <style name="TextAppearance.DVBIClient.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/ubuntu_medium</item>
        <item name="fontFamily">@font/ubuntu_medium</item>
    </style>

    <style name="TextAppearance.DVBIClient.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/ubuntu</item>
        <item name="fontFamily">@font/ubuntu</item>
    </style>

    <style name="TextAppearance.DVBIClient.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:fontFamily">@font/ubuntu_medium</item>
        <item name="fontFamily">@font/ubuntu_medium</item>
    </style>

    <style name="TextAppearance.DVBIClient.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/ubuntu</item>
        <item name="fontFamily">@font/ubuntu</item>
    </style>

    <style name="TextAppearance.DVBIClient.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/ubuntu</item>
        <item name="fontFamily">@font/ubuntu</item>
    </style>

    <style name="TextAppearance.DVBIClient.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/ubuntu_medium</item>
        <item name="fontFamily">@font/ubuntu_medium</item>
    </style>

    <style name="TextAppearance.DVBIClient.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/ubuntu</item>
        <item name="fontFamily">@font/ubuntu</item>
    </style>

    <style name="TextAppearance.DVBIClient.Overline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:fontFamily">@font/ubuntu</item>
        <item name="fontFamily">@font/ubuntu</item>
    </style>

    <!-- Screens that draw their own MaterialToolbar. -->
    <style name="Theme.DVBIClient.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Splash screen (core-splashscreen), as 5G-MAGflix's: its lettering, with DVB-I, on the dark surface. -->
    <style name="Theme.DVBIClient.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.DVBIClient</item>
    </style>
</resources>
