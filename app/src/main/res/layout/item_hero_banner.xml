<!-- The selected or first service, with what is on now: the programme's image from the content
     guide (else the service logo), the service logo, the programme title and its times. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Programme image or service logo (16:9 aspect ratio) -->
        <ImageView
            android:id="@+id/heroPosterImage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/placeholder_bg"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Strong gradient overlay covering bottom 60% -->
        <View
            android:id="@+id/heroGradient"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_hero_gradient"
            app:layout_constraintBottom_toBottomOf="@+id/heroPosterImage"
            app:layout_constraintHeight_percent="0.65"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0" />

        <!-- LIVE badge, in the place of the featured badge -->
        <TextView
            android:id="@+id/heroBadge"
            style="@style/MediaTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@drawable/bg_badge_featured"
            android:text="@string/badge_live"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Channel number -->
        <TextView
            android:id="@+id/heroLcn"
            style="@style/MediaTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_badge_lcn"
            app:layout_constraintStart_toEndOf="@+id/heroBadge"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="12dp"
            tools:text="1" />

        <!-- Service logo -->
        <ImageView
            android:id="@+id/heroLogo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="12dp"
            android:background="@drawable/bg_poster_placeholder"
            android:padding="2dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Programme title -->
        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:fontFamily="@font/ubuntu_medium"
            android:maxLines="2"
            android:textColor="@color/on_surface_primary"
            android:textSize="22sp"
            app:layout_constraintBottom_toTopOf="@+id/heroDescription"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Showcase Highlights" />

        <!-- Service, times and what is next -->
        <TextView
            android:id="@+id/heroDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/on_surface_secondary"
            android:textSize="13sp"
            app:layout_constraintBottom_toTopOf="@+id/heroProgress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="5G-MAG.tv 1 · 10:30 to 11:00" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/heroProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="14dp"
            android:importantForAccessibility="no"
            android:visibility="invisible"
            app:indicatorColor="@color/fivegmag_blue"
            app:trackColor="#4DFFFFFF"
            app:trackCornerRadius="2dp"
            app:trackThickness="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/heroPosterImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
