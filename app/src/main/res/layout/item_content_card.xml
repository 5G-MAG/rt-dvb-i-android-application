<!-- A service: its logo in the poster area with the channel number badge and the name over the
     gradient, as 5G-MAGflix's content card; below it, now/next and the information badges. Every
     card has the same size: one line each for name, now and next, badges on one line. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/fivegmag_blue"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Service logo in the poster area -->
        <ImageView
            android:id="@+id/posterImage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_poster_placeholder"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            app:layout_constraintDimensionRatio="2:3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Gradient overlay at bottom of poster -->
        <View
            android:id="@+id/gradientOverlay"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/bg_card_gradient"
            app:layout_constraintBottom_toBottomOf="@+id/posterImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Channel number, in the place of the media type badge -->
        <TextView
            android:id="@+id/lcnBadge"
            style="@style/MediaTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_badge_lcn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1" />

        <!-- Shown while the user's parental setting restricts the service -->
        <ImageView
            android:id="@+id/lockIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_info_badge"
            android:padding="3dp"
            android:src="@drawable/ic_lock"
            android:visibility="gone"
            app:tint="@color/badge_off"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Service name at bottom of poster -->
        <TextView
            android:id="@+id/contentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/ubuntu_medium"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@+id/posterImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="5G-MAG.tv 1" />

        <!-- How far the programme on now has run -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/nowProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:visibility="invisible"
            app:indicatorColor="@color/fivegmag_blue"
            app:trackColor="@color/divider_dark"
            app:trackThickness="2dp"
            app:layout_constraintTop_toBottomOf="@+id/posterImage" />

        <TextView
            android:id="@+id/nowText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:lines="1"
            android:textColor="@color/on_surface_primary"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@+id/nowProgress"
            tools:text="Showcase Highlights" />

        <TextView
            android:id="@+id/nextText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:lines="1"
            android:textColor="@color/on_surface_secondary"
            android:textSize="11sp"
            app:layout_constraintTop_toBottomOf="@+id/nowText"
            tools:text="11:00 Media over 5G" />

        <!-- Information badges on one line: what the service list signals for the service -->
        <com.fivegmag.dvbiclient.ui.BadgeRow
            android:id="@+id/badges"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nextText" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
