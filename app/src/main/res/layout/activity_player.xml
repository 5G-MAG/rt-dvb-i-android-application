<!-- The player: 5G-MAGflix's detail page with the player always in the media area, a fullscreen
     button on it, and below it the service, what is on now and next, the schedule button, the
     badges and the service instance details. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark"
    tools:context="com.fivegmag.dvbiclient.PlayerActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/detailToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/on_surface_primary"
        app:titleTextColor="@color/on_surface_primary" />

    <!-- Player (16:9; the whole screen in fullscreen) -->
    <FrameLayout
        android:id="@+id/mediaContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/black"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/detailToolbar">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            app:show_buffering="when_playing" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mediaContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- Channel number and service type badges -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lcnBadge"
                    style="@style/MediaTypeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_lcn"
                    android:visibility="gone"
                    tools:text="1"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/typeBadge"
                    style="@style/MediaTypeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_info_badge"
                    tools:text="Television" />
            </LinearLayout>

            <!-- Logo and service name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/serviceLogo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_poster_placeholder"
                    android:importantForAccessibility="no"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/serviceTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/ubuntu_medium"
                    android:textColor="@color/on_surface_primary"
                    android:textSize="24sp"
                    tools:text="5G-MAG.tv 1" />
            </LinearLayout>

            <!-- Information badges -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/badges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp" />

            <!-- Parental restriction (clause 5.5.28) -->
            <TextView
                android:id="@+id/parentalText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_info_badge"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:textColor="@color/badge_off"
                android:textSize="14sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_lock"
                app:drawableTint="@color/badge_off" />

            <!-- The programme on now; LIVE for a linear service -->
            <TextView
                android:id="@+id/liveBadge"
                style="@style/MediaTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_badge_featured"
                android:text="@string/badge_live"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/nowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/ubuntu_medium"
                android:textColor="@color/on_surface_primary"
                android:textSize="18sp"
                tools:text="Media over 5G" />

            <TextView
                android:id="@+id/nowTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/on_surface_secondary"
                android:textSize="13sp"
                tools:text="11:00 to 11:30" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/nowProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:importantForAccessibility="no"
                android:visibility="gone"
                app:indicatorColor="@color/fivegmag_blue"
                app:trackColor="@color/divider_dark"
                app:trackCornerRadius="2dp"
                app:trackThickness="3dp" />

            <TextView
                android:id="@+id/nowSynopsis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@color/on_surface_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/nextText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/on_surface_primary"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Next 11:30: Inside the Reference Tools" />

            <!-- Schedule button -->
            <Button
                android:id="@+id/scheduleButton"
                style="@style/PlayButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="@string/schedule"
                android:textSize="16sp"
                android:visibility="gone"
                app:icon="@drawable/ic_calendar_view_day"
                app:iconGravity="textStart" />

            <!-- Box Set Categories of the service's content guide source (clause 6.8.2) -->
            <Button
                android:id="@+id/boxSetsButton"
                style="@style/SettingsButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/box_sets"
                android:visibility="gone"
                app:icon="@drawable/ic_video_library"
                app:iconGravity="textStart"
                app:iconTint="@color/fivegmag_blue" />

            <!-- 5G Broadcast instances -->
            <LinearLayout
                android:id="@+id/fiveGSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/fiveGBadge"
                    style="@style/SectionHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/badge_5g"
                    app:drawableStartCompat="@drawable/ic_cell_tower"
                    app:drawableTint="@color/badge_5g_ok" />

                <TextView
                    android:id="@+id/fiveGDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="@color/on_surface_secondary"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Service instance details (clause 5.2.13) -->
            <TextView
                style="@style/SectionHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/instance_heading" />

            <TextView
                android:id="@+id/instanceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/on_surface_primary"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/discardedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/on_surface_secondary"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
