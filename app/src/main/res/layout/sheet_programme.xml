<!-- Programme information (clause 6.6) in a bottom sheet, in the style of 5G-MAGflix's detail page. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_dark_elevated">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/programmeImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/placeholder_bg"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/programmeLive"
                style="@style/MediaTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_badge_featured"
                android:text="@string/badge_live"
                android:visibility="gone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/programmeBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp" />

            <TextView
                android:id="@+id/programmeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/ubuntu_medium"
                android:textColor="@color/on_surface_primary"
                android:textSize="22sp"
                tools:text="Inside the Reference Tools" />

            <TextView
                android:id="@+id/programmeEpisode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/fivegmag_blue"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/programmeTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_surface_secondary"
                android:textSize="14sp"
                tools:text="11:30 to 12:15 · 45 min" />

            <TextView
                android:id="@+id/programmeMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/on_surface_secondary"
                android:textSize="14sp"
                tools:text="Genre: Documentary" />

            <TextView
                style="@style/SectionHeading"
                android:id="@+id/programmeSynopsisHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/synopsis" />

            <TextView
                android:id="@+id/programmeSynopsis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@color/on_surface_secondary"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/programmeNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/on_surface_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/programmeActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
