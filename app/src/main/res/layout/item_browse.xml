<!-- One programme or group of a More Episodes or Box Set page: image, title, subtitle, and the
     ON-DEMAND badge when it can be played. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="72dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/browseImage"
            android:layout_width="128dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_poster_placeholder"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/browseBadge"
                style="@style/MediaTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_badge_on_demand"
                android:text="@string/badge_on_demand"
                android:visibility="gone" />

            <TextView
                android:id="@+id/browseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/ubuntu_medium"
                android:maxLines="2"
                android:textColor="@color/on_surface_primary"
                android:textSize="15sp"
                tools:text="Signals" />

            <TextView
                android:id="@+id/browseSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/on_surface_secondary"
                android:textSize="12sp"
                tools:text="Episode 5" />
        </LinearLayout>

        <ImageView
            android:id="@+id/browseChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/on_surface_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
