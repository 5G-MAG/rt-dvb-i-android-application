<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark"
    tools:context="com.fivegmag.dvbiclient.SettingsActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_dark_elevated"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/on_surface_primary"
        app:title="@string/settings"
        app:titleTextColor="@color/on_surface_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/settingsToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="@font/ubuntu_medium"
                android:text="@string/settings_list_heading"
                android:textColor="@color/fivegmag_blue"
                android:textSize="18sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_list_description"
                android:textColor="@color/on_surface_secondary"
                android:textSize="13sp" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/service_list_url"
                app:boxStrokeColor="@color/fivegmag_blue"
                app:hintTextColor="@color/fivegmag_blue">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/serviceListUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:inputType="textUri"
                    android:textColor="@color/on_surface_primary"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:id="@+id/fallbackUrls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/on_surface_secondary"
                android:textIsSelectable="true"
                android:textSize="12sp" />
            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:background="@color/divider_dark" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="@font/ubuntu_medium"
                android:text="@string/settings_registry_heading"
                android:textColor="@color/fivegmag_blue"
                android:textSize="18sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_registry_description"
                android:textColor="@color/on_surface_secondary"
                android:textSize="13sp" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/registry_url"
                app:boxStrokeColor="@color/fivegmag_blue"
                app:hintTextColor="@color/fivegmag_blue">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/registryUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:inputType="textUri"
                    android:textColor="@color/on_surface_primary"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/country"
                app:boxStrokeColor="@color/fivegmag_blue"
                app:hintTextColor="@color/fivegmag_blue">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/country"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:inputType="textCapCharacters"
                    android:maxLength="3"
                    android:textColor="@color/on_surface_primary"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/country_hint"
                android:textColor="@color/on_surface_secondary"
                android:textSize="13sp" />
            <Button
                android:id="@+id/queryRegistry"
                style="@style/SettingsButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/query_registry" />
            <TextView
                android:id="@+id/registryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/on_surface_secondary"
                android:textIsSelectable="true"
                android:textSize="12sp" />
            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:background="@color/divider_dark" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="@font/ubuntu_medium"
                android:text="@string/settings_region_heading"
                android:textColor="@color/fivegmag_blue"
                android:textSize="18sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_region_description"
                android:textColor="@color/on_surface_secondary"
                android:textSize="13sp" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/region"
                app:placeholderText="@string/region_hint"
                app:boxStrokeColor="@color/fivegmag_blue"
                app:hintTextColor="@color/fivegmag_blue">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/region"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:inputType="text"
                    android:textColor="@color/on_surface_primary"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:id="@+id/regions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/on_surface_secondary"
                android:textIsSelectable="true"
                android:textSize="12sp" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/packages"
                app:placeholderText="@string/packages_hint"
                app:boxStrokeColor="@color/fivegmag_blue"
                app:hintTextColor="@color/fivegmag_blue">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/packages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:inputType="text"
                    android:textColor="@color/on_surface_primary"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:id="@+id/listPackages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/on_surface_secondary"
                android:textIsSelectable="true"
                android:textSize="12sp" />
            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:background="@color/divider_dark" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="@font/ubuntu_medium"
                android:text="@string/settings_parental_heading"
                android:textColor="@color/fivegmag_blue"
                android:textSize="18sp" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/parental"
                app:boxStrokeColor="@color/fivegmag_blue"
                app:hintTextColor="@color/fivegmag_blue">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/parental"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:inputType="number"
                    android:textColor="@color/on_surface_primary"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/parental_hint"
                android:textColor="@color/on_surface_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/save"
                style="@style/PlayButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="@string/save"
                android:textSize="16sp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:background="@color/divider_dark" />
            <!-- Version Info -->
            <TextView
                android:id="@+id/settingsVersionNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface_secondary"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
